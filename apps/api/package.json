{
  "name": "@open-pages/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --exclude ../../workspaces --exclude ./workspaces --exclude \"**/workspaces/**\" src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.1",
    "@octokit/rest": "^22.0.0",
    "@open-pages/hexo-runner": "workspace:*",
    "@open-pages/shared": "workspace:*",
    "hono": "^4.9.8",
    "iron-webcrypto": "^1.2.1"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
