<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Ad-hoc signing (APPLE_SIGNING_IDENTITY=-) enables Hardened Runtime on
       every binary Tauri signs, including the Node sidecar. V8 maps RWX pages
       during Isolate::Initialize; without these keys the kernel delivers
       SIGTRAP and the UI reports "desktop runtime exited before becoming ready". -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
</dict>
</plist>
