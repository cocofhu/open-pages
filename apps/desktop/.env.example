# Public OAuth App client id. No client secret — desktop uses PKCE.
# Dev: loaded at runtime. Release CI embeds OPEN_PAGES_GITHUB_CLIENT_ID at compile time.
# Locally you can use either name; GitHub Actions Variables cannot start with GITHUB_.
GITHUB_CLIENT_ID=
# OPEN_PAGES_GITHUB_CLIENT_ID=
OPEN_PAGES_CONTROL_PORT=3848
OPEN_PAGES_PREVIEW_PORT=8788
OPEN_PAGES_PREVIEW_ORIGIN=http://127.0.0.1:8788
