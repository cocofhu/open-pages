# Optional override. Device Flow uses the official Open Pages Client ID by default.
# Dev: loaded at runtime. Release CI can still embed OPEN_PAGES_GITHUB_CLIENT_ID.
# GITHUB_CLIENT_ID=
# OPEN_PAGES_GITHUB_CLIENT_ID=
OPEN_PAGES_CONTROL_PORT=3848
OPEN_PAGES_PREVIEW_PORT=8788
OPEN_PAGES_PREVIEW_ORIGIN=http://127.0.0.1:8788
