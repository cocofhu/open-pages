PORT=8787
APP_ORIGIN=http://localhost:5173
API_ORIGIN=http://localhost:8787
# Generated sites run untrusted theme code, so they are served from an origin of
# their own that carries no session cookie. It must differ from APP_ORIGIN.
PREVIEW_PORT=8788
PREVIEW_ORIGIN=http://localhost:8788
SESSION_SECRET=replace-with-a-long-random-string-32+
WORKSPACE_ROOT=./workspaces
# Opt-in: allow unauthenticated users to install npm/GitHub Hexo addons.
# ALLOW_GUEST_ADDONS=true
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
